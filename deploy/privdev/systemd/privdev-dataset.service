[Unit]
Description=PrivDev Study 1 dataset export (pull both labelings, build the annotation dataset)

[Service]
Type=oneshot
# Placeholders are filled in when the unit is installed (see README, "Dataset timer"):
#   @PRIVDEV_MAPPINGS_DIR@   the privdev-mappings directory of the PrivDev checkout
#                            (where pyproject.toml lives, so `uv run` finds the project)
#   @DATASET_ENV@            env file, mode 0600, with the variables below
# Variables of the env file:
#   LABELING_A                 AnnotAISE labeling ID of part A (starting part)
#   LABELING_B                 AnnotAISE labeling ID of part B (main part); may be empty
#                              before part B exists, then --labeling-b is left out
#   ANNOTAISE_URL              the backend base, <public-url>/backend
#   ANNOTAISE_EXPORT_EMAIL     export account e-mail
#   ANNOTAISE_EXPORT_PASSWORD  export account password
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=@PRIVDEV_MAPPINGS_DIR@
EnvironmentFile=@DATASET_ENV@
ExecStart=/bin/sh -c 'exec uv run python -m privdev.annotation.dataset --labeling-a "$LABELING_A" ${LABELING_B:+--labeling-b $LABELING_B}'
