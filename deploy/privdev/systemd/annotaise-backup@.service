[Unit]
Description=AnnotAISE pg_dump backup for %i

[Service]
Type=oneshot
# Repository at ~/annotaise/repo (a symlink is fine). Optional overrides
# (COMPOSE=podman compose, ANNOTAISE_BACKUP_ROOT=...) go in this file:
EnvironmentFile=-%h/.config/annotaise/backup.env
ExecStart=%h/annotaise/repo/deploy/privdev/backup.sh %i
