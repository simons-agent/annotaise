[Unit]
Description=AnnotAISE pg_dump backup for %i

[Service]
Type=oneshot
# Install-time placeholders (see README): @REPO_DIR@ is the checkout, and
# @BACKUP_ENV@ is a file that must set ANNOTAISE_BACKUP_ROOT (required) and may
# set COMPOSE (e.g. COMPOSE=podman compose).
EnvironmentFile=@BACKUP_ENV@
ExecStart=@REPO_DIR@/deploy/privdev/backup.sh %i
